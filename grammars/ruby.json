{
  "name": "Ruby",
  "scopeName": "source.ruby",
  "type": "tree-sitter",
  "parser": "tree-sitter-ruby",
  "injectionNames": ["rb", "ruby", "jruby", "macruby", "rake", "rbx"],
  "treeSitter": {
    "parserSource": "github:tree-sitter/tree-sitter-ruby#ad907a69da0c8a4f7a943a7fe012712208da6dee",
    "wasmBuildTool": "tree-sitter-cli#v0.27.1",
    "grammar": "ruby.wasm",
    "highlightsQuery": "ruby-highlights.scm",
    "localsQuery": "ruby-locals.scm",
    "foldsQuery": "ruby-folds.scm",
    "indentsQuery": "ruby-indents.scm",
    "tagsQuery": "ruby-tags.scm",
    "injectionsQuery": "ruby-injections.scm"
  },
  "firstLineRegex": [
    // shebang line
    "^#![ \\t]*(?:(?:[^\\s]+[\\\\/])?(?:ruby(?:[0-9.]+)?(?:\\.exe)?|rubyw(?:\\.exe)?|jruby|truffleruby|rake)|(?:[^\\s]+[\\\\/])?env(?:\\.exe)?[ \\t]+(?:-S[ \\t]+)?(?:ruby(?:[0-9.]+)?(?:\\.exe)?|rubyw(?:\\.exe)?|jruby|truffleruby|rake))(?:[ \\t\\r\\n]|$)",
    // vim modeline
    // Stop at the first Vim and set tokens instead of backtracking over them.
    // \x0a keeps existing shebang prefix line counts unchanged.
    "(?:^|\\x0a)(?:(?!vim\\b).)*vim\\b(?:(?!\\bset\\b).)*\\bset\\b.*\\b(filetype|ft|syntax)=ruby(?![\\w.-])"
  ],
  "fileTypes": [
    "rb",
    "rbi",
    "Guardfile",
    "Vagrantfile",
    "Thorfile",
    "Dangerfile",
    "ru",
    "rake",
    "gemspec",
    "Podfile",
    "Brewfile",
    "Rakefile",
    "Gemfile",
    "rjs",
    "rxml",
    "builder",
    "jbuilder",
    "json_builder"
  ],
  "comments": {
    "start": "# "
  }
}
