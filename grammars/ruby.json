{
  "name": "Ruby",
  "scopeName": "source.ruby",
  "type": "tree-sitter",
  "parser": "tree-sitter-ruby",
  "injectionNames": ["rb", "ruby"],
  "treeSitter": {
    "parserSource": "github:tree-sitter/tree-sitter-ruby#v0.23.1",
    "wasmBuildTool": "tree-sitter-cli#v0.26.13",
    "grammar": "ruby.wasm",
    "highlightsQuery": "ruby-highlights.scm",
    "localsQuery": "ruby-locals.scm",
    "foldsQuery": "ruby-folds.scm",
    "indentsQuery": "ruby-indents.scm",
    "tagsQuery": "ruby-tags.scm"
  },
  "firstLineRegex": [
    // shebang line
    "^#!.*\\b(w*ruby|rake)\\r?\\n",
    // vim modeline
    "vim\\b.*\\bset\\b.*\\b(filetype|ft|syntax)=ruby"
  ],
  "fileTypes": [
    "rb",
    "ru",
    "rake",
    "gemspec",
    "Podfile",
    "Brewfile",
    "Rakefile",
    "Gemfile",
    "rjs",
    "rxml",
    "builder",
    "jbuilder",
    "json_builder"
  ],
  "comments": {
    "start": "# "
  }
}
