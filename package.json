{
  "name": "language-ruby",
  "author": "lumine-code",
  "version": "1.0.0",
  "main": "lib/main",
  "files": [
    "grammars",
    "lib",
    "settings",
    "snippets",
    "spec",
    "THIRD_PARTY_NOTICES"
  ],
  "description": "Ruby language support.",
  "keywords": [
    "rb",
    "gem",
    "rake",
    "gemfile",
    "rails",
    "bundler",
    "tree-sitter"
  ],
  "engines": {
    "lumine": "^1.0.0",
    "node": ">=24"
  },
  "specPackages": [
    "language-regex",
    "language-source",
    "language-text"
  ],
  "license": "MIT",
  "repository": "https://github.com/lumine-code/language-ruby",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.5.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1"
  },
  "bugs": {
    "url": "https://github.com/lumine-code/language-ruby/issues"
  },
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "overrides": {
    "eslint@^10.14.0": {
      "minimatch": "11.0.8"
    },
    "@eslint/config-array@0.23.5": {
      "minimatch": "11.0.8"
    }
  }
}
